#!/bin/sh
# Stand-in for libsecret's secret-tool. Logs every command line (so tests can
# prove the token never appears on one) and keeps the secret in a file.
dir="${FAKE_KEYRING:?FAKE_KEYRING not set}"
printf '%s\n' "$*" >> "$dir/argv"
case "$1" in
  store) cat > "$dir/secret" ;;
  lookup) [ -f "$dir/secret" ] && cat "$dir/secret" || exit 1 ;;
  clear) rm -f "$dir/secret" ;;
  *) exit 2 ;;
esac

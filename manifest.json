{
  "schemaVersion": 1,
  "id": "io.github.gsottnick.howismyplug",
  "name": "HowIsMyPlug?",
  "version": "1.0.0",
  "author": "Gavin Sottnick",
  "license": "MIT",
  "description": "For plugin authors: lifetime clones and repo views for your GitHub repos, plus your marketplace listing's views, copies and hearts. Free, local, with milestone celebrations.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "HowIsMyPlug?",
    "description": "Clones, repo views and marketplace stats for the plugins you publish, kept forever instead of GitHub's 14 days.",
    "category": "Developer Tools",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "period": "all",
      "countMode": "both",
      "barSource": "all",
      "barStat": "clones",
      "panelSize": "normal",
      "accent": "theme",
      "animations": true,
      "showCombined": true,
      "combinedMilestones": true,
      "milestoneMetric": "clones",
      "milestoneStep": 100,
      "defaultCheckGithub": "daily",
      "defaultCheckListing": "daily"
    },
    "schema": [
      {
        "key": "period",
        "type": "enum",
        "label": "Period shown",
        "options": [
          "7d",
          "14d",
          "30d",
          "all"
        ],
        "defaultValue": "all"
      },
      {
        "key": "countMode",
        "type": "enum",
        "label": "Clones and views: total, unique, or both",
        "options": [
          "total",
          "unique",
          "both"
        ],
        "defaultValue": "both"
      },
      {
        "key": "barSource",
        "type": "string",
        "label": "Bar number from: all, or a tracked repo (owner/repo)",
        "defaultValue": "all"
      },
      {
        "key": "barStat",
        "type": "enum",
        "label": "Bar number shows",
        "options": [
          "clones",
          "uniqueClones",
          "views",
          "uniqueViews",
          "listingViews",
          "copies",
          "hearts"
        ],
        "defaultValue": "clones"
      },
      {
        "key": "panelSize",
        "type": "enum",
        "label": "Dropdown size",
        "options": [
          "compact",
          "normal",
          "tall"
        ],
        "defaultValue": "normal"
      },
      {
        "key": "accent",
        "type": "enum",
        "label": "Highlight colour, from the theme",
        "options": [
          "theme",
          "foreground",
          "urgent"
        ],
        "defaultValue": "theme"
      },
      {
        "key": "animations",
        "type": "boolean",
        "label": "Animations",
        "defaultValue": true
      },
      {
        "key": "showCombined",
        "type": "boolean",
        "label": "Show combined totals for all repos",
        "defaultValue": true
      },
      {
        "key": "combinedMilestones",
        "type": "boolean",
        "label": "Milestones for all repos added up (each repo's own are set in the dropdown)",
        "defaultValue": true
      },
      {
        "key": "milestoneMetric",
        "type": "enum",
        "label": "Combined milestones count",
        "options": [
          "clones",
          "uniqueClones",
          "views",
          "uniqueViews",
          "listingViews",
          "copies",
          "hearts"
        ],
        "defaultValue": "clones"
      },
      {
        "key": "milestoneStep",
        "type": "integer",
        "label": "A combined milestone every",
        "min": 1,
        "max": 1000000,
        "step": 10,
        "defaultValue": 100
      },
      {
        "key": "defaultCheckGithub",
        "type": "enum",
        "label": "New repos: check GitHub traffic",
        "options": [
          "hourly",
          "daily",
          "weekly",
          "biweekly"
        ],
        "defaultValue": "daily"
      },
      {
        "key": "defaultCheckListing",
        "type": "enum",
        "label": "New repos: check the listing",
        "options": [
          "hourly",
          "daily",
          "weekly",
          "biweekly"
        ],
        "defaultValue": "daily"
      }
    ]
  }
}
